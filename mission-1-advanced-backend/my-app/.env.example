VITE_API_BASE_URL=/api

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=imtrack_db
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# file: simpan .eml di server/storage/mail, tanpa mengirim ke inbox.
# smtp: kirim email sungguhan menggunakan konfigurasi di bawah.
MAIL_MODE=file
MAIL_FROM=ImTrack <no-reply@imtrack.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TEST_TO=
