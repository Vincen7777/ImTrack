{
  "info": {
    "name": "ImTrack — Advanced Backend Mission",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Register, baca email lokal/SMTP, isi verificationToken, Verify email, lalu Login. Login menyimpan accessToken. Pilih gambar sendiri untuk Upload. Endpoint auth tidak memakai Bearer."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "fullname",
      "value": "Student ImTrack",
      "type": "string"
    },
    {
      "key": "username",
      "value": "student_postman",
      "type": "string"
    },
    {
      "key": "email",
      "value": "student-postman@example.test",
      "type": "string"
    },
    {
      "key": "password",
      "value": "LocalPassword123!",
      "type": "string"
    },
    {
      "key": "verificationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullname\": \"{{fullname}}\",\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify email — isi verificationToken dari email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/verify-email",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login — simpan accessToken",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"accessToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Profil akun",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create task — simpan taskId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/task",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Belajar Express\",\n  \"priority\": \"Sekarang\",\n  \"status\": \"todo\",\n  \"due\": \"2026-12-20\",\n  \"cat\": \"Belajar\",\n  \"tags\": [\n    \"backend\",\n    \"node\"\n  ],\n  \"isRecurring\": true,\n  \"recurrenceType\": \"weekly\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"taskId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/task"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter + search + sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/task?cat=Belajar&status=todo&priority=Sekarang&search=Express&sort=title&order=asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get task by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/task/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/task/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"done\",\n  \"isRecurring\": false,\n  \"tags\": [\n    \"selesai\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload foto profil — pilih file",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/upload",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Upload berhasil\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/task/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Kirim ulang verifikasi (opsional)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/resend-verification",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Tanpa token ditolak",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/task",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
